{
  "name": "cork-ai",
  "version": "0.9.0",
  "description": "Claude Code cost tool \u2014 outlines whole-file reads when it pays off, and shows what your context size really costs",
  "bin": {
    "cork-ai": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsup --entry.cli/index src/cli/index.ts --format cjs --clean",
    "dev": "tsup --entry.cli/index src/cli/index.ts --format cjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "benchmark": "node --loader tsx/esm benchmarks/cost-comparison.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test",
    "build:sdk": "tsup src/sdk/index.ts --format cjs,esm --dts --out-dir dist/sdk"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "context",
    "tokens",
    "cost",
    "hooks",
    "compaction",
    "ai"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "docs",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@types/node": "^20.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.4.0",
    "vitest": "^2.0.0"
  },
  "optionalDependencies": {
    "tiktoken": "^1.0.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mqthys62/cork-ai.git"
  },
  "bugs": {
    "url": "https://github.com/mqthys62/cork-ai/issues"
  },
  "homepage": "https://github.com/mqthys62/cork-ai#readme"
}
